logging:
  file: "telegram_regger.log"
  level: "INFO"

paths:
  cech_file: "cech.json"
  sessions_converted_dir: "sessions/converted"
  telethon_sessions_dir: "sessions/telethon"
  telegram_desktop_accounts_dir: "sessions/tg_desk"
  telegram_desktop_executable: "Telegram.exe"
  telegram_desktop_data_dir: "%LOCALAPPDATA%\\Telegram Desktop"
  last_names_file: "data/last_names.txt"
  chrome_executable: "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe"
  express_vpn_executable: "C:\\Program Files (x86)\\ExpressVPN\\expressvpn-ui\\ExpressVPN.exe"
  adb_executable: "adb"

adb:
  adb_path: "adb"
  device_udid: "127.0.0.1:5555"
  appium_port: 4723
  physical_device: false

concurrency:
  max_workers: 1
  device_list:
    - "127.0.0.1:5555"

emulator:
  executable_path: "C:\\LDPlayer\\LDPlayer9\\dnplayer.exe"
  process_name: "dnplayer.exe"

sms_api:
  # Supported providers: "sms-activate", "grizzly-sms", "hero-sms"
  # Aliases for HeroSMS are also accepted in code: "herosms", "hero_sms"
  service_name: "sms-activate"
  # Optional handler API URL override (takes priority over service_name mapping)
  # api_url: "https://hero-sms.com/stubs/handler_api.php"
  api_key_path: "secrets/sms_api_key.txt"
  telegram_service_code: "tg"

proxy_api:
  key: "YOUR_PROXY_SELLER_API_KEY"
  url: "https://proxy-seller.com/api/v1/proxy/list"
  rotate_url: "https://proxy-seller.com/api/v1/proxy/rotate"
  method: "GET"
  timeout_seconds: 20
  default_type: "socks5"

telethon:
  api_id: 1231
  api_hash: ""
  device_model: "Desktop"
  system_version: "Windows 10"
  app_version: "4.0.4 x64"
  system_lang_code: "en"
  lang_code: "en"

registration:
  prompt_for_country: true
  default_country: "USA"
  prompt_for_max_price: true
  default_max_price: 10.0
  continue_prompt: true
  anti_bot_min_delay_seconds: 2.0
  anti_bot_max_delay_seconds: 5.0
  telegram_code_input_xpath: "//android.widget.EditText"

windows_automation:
  vpn_window_title_regex: "ExpressVPN.*"
  telegram_window_title: "Telegram"

timeouts:
  element_search_seconds: 10
  page_load_seconds: 30
  window_wait_seconds: 20
  poll_interval_seconds: 1.0
  desktop_key_delay_seconds: 0.2
  vpn_settle_seconds: 5.0
  process_shutdown_seconds: 15
  sms_code_wait_seconds: 120
  telethon_code_wait_seconds: 120
  sms_read_attempt_seconds: 20
  sms_code_poll_seconds: 5.0
